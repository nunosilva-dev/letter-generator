{
  "name": "letter-generator-documentation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "preview": "astro preview --host 127.0.0.1",
    "prepare:assets": "node scripts/prepare-assets.mjs",
    "test": "node --test --test-isolation=none scripts/tests/*.test.mjs",
    "check:reference": "node scripts/check-reference.mjs",
    "build": "pnpm prepare:assets && pnpm check:reference && astro build && node scripts/check-links.mjs",
    "verify": "pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.1"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "linkedom": "0.18.12"
  }
}
